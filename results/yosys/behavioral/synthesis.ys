read_verilog -Irtl rtl/structural.v rtl/behavioral.v rtl/demo_datapath.v
hierarchy -check -top alu_behavioral
proc
select -assert-none t:$dlatch
synth -top alu_behavioral -flatten -noabc
delete t:$scopeinfo
check -assert
select -assert-none t:$_DLATCH_*
tee -o results/yosys/behavioral/statistics.json stat -json
rename alu_behavioral alu_netlist
write_verilog -noattr results/yosys/behavioral/netlist.v
